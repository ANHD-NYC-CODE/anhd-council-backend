# includes portal, staging.portal, and api hosts)
# WEBAUTHN_ALLOWED_ORIGINS=https://portal.displacementalert.org,https://staging.portal.displacementalert.org,https://api.displacementalert.org
# Optional ISO datetime; default in settings is 2026-10-08 America/New_York
# MFA_STAFF_ENFORCEMENT_START=2026-10-08T00:00:00-04:00